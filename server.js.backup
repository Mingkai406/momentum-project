const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const morgan = require('morgan');

const app = express();

// Middleware
app.use(helmet());
app.use(cors());
app.use(express.json());
app.use(morgan('combined'));

// PostgreSQL configuration
const dbConfig = {
  host: process.env.DB_HOST || 'localhost',
  port: process.env.DB_PORT || 5432,
  database: process.env.DB_NAME || 'momentum',
  user: process.env.DB_USER || 'postgres',
  password: process.env.DB_PASSWORD || 'postgres'
};

// In-memory data (simulating PostgreSQL)
let tasks = [
  { id: 1, title: "Deploy to AWS EC2", status: "in-progress", priority: "high", created_at: new Date() },
  { id: 2, title: "Setup CI/CD Pipeline", status: "todo", priority: "medium", created_at: new Date() },
  { id: 3, title: "PostgreSQL Integration", status: "todo", priority: "high", created_at: new Date() },
  { id: 4, title: "Docker Configuration", status: "completed", priority: "low", created_at: new Date() }
];

// Health check
app.get('/', (req, res) => {
  res.json({
    status: 'healthy',
    service: 'momentum-backend',
    version: '1.0.0',
    database: 'PostgreSQL configured',
    timestamp: new Date().toISOString()
  });
});

// Get all tasks
app.get('/api/tasks', (req, res) => {
  res.json({
    success: true,
    count: tasks.length,
    tasks: tasks
  });
});

// Create task
app.post('/api/tasks', (req, res) => {
  const task = {
    id: tasks.length + 1,
    title: req.body.title,
    status: req.body.status || 'todo',
    priority: req.body.priority || 'medium',
    created_at: new Date()
  };
  tasks.push(task);
  res.status(201).json({ success: true, task });
});

// Schedule task for Go service
app.post('/api/schedule', (req, res) => {
  res.json({
    success: true,
    message: 'Task scheduled for concurrent processing',
    processing_service: 'Go microservice',
    workers: 10
  });
});

const PORT = process.env.PORT || 3001;
app.listen(PORT, () => {
  console.log(`Backend API running on port ${PORT}`);
  console.log(`Database: PostgreSQL (${dbConfig.database})`);
});
