{
  "name": "momentum",
  "private": true,
  "version": "3.0.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @momentum/web",
    "typecheck": "npm run typecheck -w @momentum/web",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write apps scripts tests playwright*.config.ts database docs README.md .github/workflows",
    "format:check": "prettier --check apps scripts tests playwright*.config.ts docs README.md .github/workflows",
    "build:preview": "node scripts/build-preview.mjs",
    "test:preview": "playwright test -c playwright.preview.config.ts",
    "serve:preview": "node scripts/serve-preview.mjs",
    "test:agent:browser": "playwright test -c playwright.agent.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
