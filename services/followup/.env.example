# Same high-entropy value in Express and this private service; never NEXT_PUBLIC_*.
FOLLOWUP_AGENT_TOKEN=replace-with-at-least-32-random-characters
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
FOLLOWUP_MODEL=gemini-2.5-flash
# Set from the current published price for your chosen model; omit for null cost.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
