# Only needed for a hosted installation. `npm run dev` configures local demo mode itself.
AUTH_MODE=cognito
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/momentum
RUN_MIGRATIONS=false
WEB_ORIGIN=https://YOUR_WEB_HOST
COGNITO_USER_POOL_ID=us-east-1_YOUR_POOL
COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
COGNITO_MENTOR_GROUP=mentors
# Next.js public variables are embedded at BUILD time.
NEXT_PUBLIC_API_URL=https://YOUR_API_HOST
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_YOUR_POOL
NEXT_PUBLIC_COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
